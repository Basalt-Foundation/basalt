<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- AOT analyzers for all projects -->
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <!-- Common metadata -->
  <PropertyGroup>
    <Authors>Basalt Foundation</Authors>
    <Company>Basalt</Company>
    <Product>Basalt Blockchain</Product>
    <Copyright>Copyright (c) 2025-2026 Basalt Foundation</Copyright>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- NuGet packaging. Only the durable libraries consumed by external tools (e.g. Trilith.KeyGate) set
       IsPackable=true; everything else (node, tools, tests) stays unpackable by this default. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.4.0-testnet</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Basalt-Foundation/basalt</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Basalt-Foundation/basalt</PackageProjectUrl>
  </PropertyGroup>
</Project>
